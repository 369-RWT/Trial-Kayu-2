# Database
# For local development with SQLite (not recommended for production):
# DATABASE_URL="file:./dev.db"
# For production with PostgreSQL (Neon, Supabase, etc.):
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Application
NEXT_PUBLIC_APP_NAME="Al Fath Kayu"
NEXT_PUBLIC_APP_DESCRIPTION="Multi-Wood-Type Precision Costing System"

# Authentication (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Rate Limiting (Upstash Redis - Optional)
# If not provided, falls back to in-memory rate limiting
# UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# CORS (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Environment
NODE_ENV="development"
